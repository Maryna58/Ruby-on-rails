<p style="color: green"><%= notice %></p>

<% content_for :title, "Категорії" %>

<h1>Категорії</h1>

<div id="categories">
  <% @categories.each do |category| %>
    <%= render category %>
  <% end %>
</div>

<hr style="margin-top: 20px; margin-bottom: 20px;" />

<div style="font-size: 16px;">
  <%= link_to "Додати нову категорію", new_category_path, style: "font-weight: bold;" %> |
  <%= link_to "Повернутися на основну сторінку", recipes_path %>
</div>