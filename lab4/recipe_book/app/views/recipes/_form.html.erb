<%= form_with(model: recipe, class: "needs-validation") do |form| %>
  <% if recipe.errors.any? %>
    <div class="alert alert-danger shadow-sm">
      <h5 class="alert-heading"><%= pluralize(recipe.errors.count, "помилка не дозволяє", "помилки не дозволяють", "помилок не дозволяють") %> зберегти рецепт:</h5>
      <ul class="mb-0">
        <% recipe.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="row">
    <div class="col-md-7">
      <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-light fw-bold text-dark py-3"> Основні дані</div>
        <div class="card-body p-4">
          <div class="mb-3">
            <%= form.label :title, "Назва рецепту", class: "form-label fw-medium" %>
            <%= form.text_field :title, class: "form-control" %>
          </div>

          <div class="mb-3">
            <%= form.label :category_id, "Категорія", class: "form-label fw-medium" %>
            <%= form.select :category_id, Category.pluck(:name, :id), { prompt: "Оберіть категорію" }, class: "form-select" %>
          </div>

          <div class="row">
            <div class="col-md-6 mb-3">
              <%= form.label :cooking_time, "Час приготування (хв)", class: "form-label fw-medium" %>
              <%= form.number_field :cooking_time, class: "form-control" %>
            </div>
            <div class="col-md-6 mb-3">
              <%= form.label :servings, "Кількість порцій", class: "form-label fw-medium" %>
              <%= form.number_field :servings, class: "form-control" %>
            </div>
          </div>

          <div class="mb-3">
            <%= form.label :difficulty, "Складність", class: "form-label fw-medium" %>
            <%= form.select :difficulty, Recipe.difficulties.keys.map { |w| [w.humanize, w] }, { prompt: "Оберіть складність" }, class: "form-select" %>
          </div>

          <div class="mb-3">
            <%= form.label :ingredients, "Інгредієнти", class: "form-label fw-medium" %>
            <%= form.text_area :ingredients, rows: 4, class: "form-control" %>
          </div>

          <div class="mb-3">
            <%= form.label :steps, "Кроки приготування", class: "form-label fw-medium" %>
            <%= form.text_area :steps, rows: 5, class: "form-control" %>
          </div>

          <div class="form-check form-switch mt-4">
            <%= form.check_box :published, class: "form-check-input", role: "switch" %>
            <%= form.label :published, "Опублікувати рецепт (видимий для всіх)", class: "form-check-label fw-bold text-success" %>
          </div>
        </div>
      </div>
    </div>

    <div class="col-md-5">
      <div class="card shadow-sm border-0 mb-4 bg-light">
        <div class="card-header bg-secondary text-white fw-bold py-3"> Фотографії страви</div>
        <div class="card-body p-3">
          
          <p class="text-muted small mb-3">Додайте посилання на фотографії. Залиште поле URL порожнім, якщо не хочете додавати фото.</p>

          <%= form.fields_for :photos do |photo_form| %>
            <div class="card mb-3 border border-secondary border-opacity-25 shadow-xs">
              <div class="card-body p-3">
                <div class="mb-2">
                  <%= photo_form.label :url, "URL зображення", class: "form-label small fw-bold mb-1" %>
                  <%= photo_form.text_field :url, class: "form-control form-control-sm", placeholder: "https://..." %>
                </div>
                <div class="mb-2">
                  <%= photo_form.label :caption, "Підпис", class: "form-label small fw-bold mb-1" %>
                  <%= photo_form.text_field :caption, class: "form-control form-control-sm", placeholder: "Наприклад: Готова страва" %>
                </div>
                <% if photo_form.object.persisted? %>
                  <div class="form-check mt-3 text-end">
                    <%= photo_form.check_box :_destroy, class: "form-check-input float-none ms-0 me-2" %>
                    <%= photo_form.label :_destroy, "Видалити це фото", class: "form-check-label text-danger small fw-bold" %>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>

        </div>
      </div>
    </div>
  </div>

  <div class="d-flex gap-3 mb-5">
    <%= form.submit "Зберегти рецепт", class: "btn btn-primary px-5 py-2 fw-bold shadow-sm" %>
    <%= link_to "Скасувати", recipes_path, class: "btn btn-outline-secondary py-2 px-4" %>
  </div>
<% end %>