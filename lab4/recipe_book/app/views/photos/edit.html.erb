<div class="container mt-5" style="max-width: 500px;">
  <div class="card shadow-sm border-0">
    <div class="card-header bg-dark text-white py-3">
      <h3 class="card-title mb-0 fs-5">Редагування інформації про фото</h3>
    </div>
    <div class="card-body p-4">
      <%= form_with(model: @photo, local: true) do |form| %>
        <div class="mb-3">
          <%= form.label :url, "URL-адреса зображення", class: "form-label fw-bold" %>
          <%= form.text_field :url, class: "form-control" %>
        </div>

        <div class="mb-3">
          <%= form.label :caption, "Підпис до фото", class: "form-label fw-bold" %>
          <%= form.text_field :caption, class: "form-control" %>
        </div>

        <div class="d-flex gap-2 mt-4">
          <%= form.submit "Оновити дані", class: "btn btn-primary fw-medium" %>
          <%= link_to "Скасувати", recipe_path(@photo.recipe_id), class: "btn btn-outline-secondary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>