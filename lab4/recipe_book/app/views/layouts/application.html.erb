<!DOCTYPE html>
<html>
  <head>
    <title>Менеджер рецептів</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
      <div class="container">
        <%= link_to "Менеджер рецептів", recipes_path, class: "navbar-brand" %>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav me-auto">
            <li class="nav-item">
              <%= link_to "Всі рецепти", recipes_path, class: "nav-link" %>
            </li>
            <li class="nav-item">
              <%= link_to "Опубліковані", published_recipes_path, class: "nav-link" %>
            </li>
            <li class="nav-item">
              <%= link_to "Категорії", categories_path, class: "nav-link" %>
            </li>
            <li class="nav-item">
  <%= link_to "Швидкі рецепти", quick_recipes_path, class: "nav-link" %>
</li>
            
          </ul>
          <ul class="navbar-nav">
            <li class="nav-item">
              <%= link_to "Новий рецепт", new_recipe_path, class: "btn btn-success" %>
            </li>
          </ul>
        </div>
      </div>
    </nav>

    <div class="container mt-4">
      <% if notice %>
        <div class="alert alert-success" role="alert">
          <%= notice %>
        </div>
      <% end %>

      <%= yield %>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>